# Rollcall settings. Copy to .env (cp .env.example .env) and fill in the two passwords.
# .env is never committed. Generate each secret with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# Use that generator: its letters, digits, - and _ are safe inside the database URL.

# Password for the PostgreSQL database. Compose builds DATABASE_URL from it. Required.
POSTGRES_PASSWORD=

# Signs staff sign-in sessions. At least 32 characters. Changing it signs everyone out. Required.
SECRET_KEY=

# The shop's time zone: used for "this week" on the dashboard and for every time shown. Required.
SHOP_TIMEZONE=America/Chicago

# Port on this PC where Rollcall is reached: http://localhost:8080 or http://<this PC's IP>:8080.
APP_PORT=8080

# Optional tuning. The defaults suit one shop.
# LOG_LEVEL=INFO          # DEBUG, INFO, WARNING, ERROR or CRITICAL
# DB_POOL_SIZE=10         # database connections per worker process, 1 to 50
# WEB_CONCURRENCY=2       # worker processes
